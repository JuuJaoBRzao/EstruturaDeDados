      - Localizar
          vetor = (5, 9, 7, 2, 5)
          TAM = 5

          - C
              numero = 5;
              encontrado = false;
              for (int i = 0; i < TAM; i++) {
                if (numero == vetor[i]) {
                  encontrado = true;
                  break;
                }
              }  
              if (encontrado) {
                print("Numero encontrado");
              } else {
                print("Numero não encontrado");
              }

          - Python
                vetor = (5, 9, 7, 5, 3)
                numero = 5
                if numero in vetor:
                  print("Encontrado")
                else
                  printf("Não encontrado")

           - Java
                vetor = (5, 9, 7, 5, 3)
                numero = 5
                if (vetor.contains(numero)) {
                  System.out.printIn("Encontrado");
                } else {
                  System.out.printIn("Não encontrado");
                }

           - C#
                vetor = (5, 9, 7, 5, 3)
